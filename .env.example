# ==============================================================================
# SMARTPACK AI - PROJECT ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the services
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL credentials for the DB container
POSTGRES_USER=smartpack_user
POSTGRES_PASSWORD=smartpack_password
POSTGRES_DB=smartpack_db
POSTGRES_PORT=5432

# SQLAlchemy database connection string
# Docker internal network format: postgresql://[user]:[pass]@[service_name]:[port]/[db_name]
DATABASE_URL=postgresql://smartpack_user:smartpack_password@db:5432/smartpack_db

# Local development fallback connection string (e.g. for running backend outside Docker)
# LOCAL_DATABASE_URL=sqlite:///./smartpack_local.db
LOCAL_DATABASE_URL=postgresql://smartpack_user:smartpack_password@localhost:5432/smartpack_db

# ------------------------------------------------------------------------------
# BACKEND CORE CONFIGURATION
# ------------------------------------------------------------------------------
# Execution environment (development, staging, production)
ENVIRONMENT=development

# Host and port for the API server
API_HOST=0.0.0.0
API_PORT=8000

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# JWT signing key (Min 32 characters, generated via openssl rand -hex 32)
JWT_SECRET=8f5db9cf2b4d89617ad565e3150244cf5ef02b1bcfa9b4a1b0235b2e9d7c01b2

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# LOGGING POLICY
# ------------------------------------------------------------------------------
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Directory where application logs are stored
LOG_DIR=./logs

# Log file rotation policy limit (size-based rotation)
LOG_ROTATION_SIZE=50MB

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Endpoint URI of the FastAPI API Gateway
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
